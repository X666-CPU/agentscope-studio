# AgentScope Studio - Multi-stage Dockerfile
# 适用于 CI/CD (GitHub Actions) 完整构建

# ===== Stage 1: 构建前端 =====
FROM node:22-alpine AS client-builder

WORKDIR /app
COPY package.json package-lock.json ./
COPY packages/client ./packages/client
COPY packages/shared ./packages/shared

RUN npm config set registry https://registry.npmmirror.com
RUN npm install
RUN npm run build --workspace=packages/client

# ===== Stage 2: 构建后端 =====
FROM node:22-alpine AS server-builder

RUN apk add --no-cache python3 make g++

WORKDIR /app
COPY package.json package-lock.json ./
COPY packages/server ./packages/server
COPY packages/shared ./packages/shared

RUN npm config set registry https://registry.npmmirror.com
RUN npm install
RUN npm run build --workspace=packages/server

# ===== Stage 3: 生产镜像 =====
FROM node:22-alpine

RUN apk add --no-cache python3 make g++

WORKDIR /app

# 从构建阶段复制产物
COPY --from=client-builder /app/packages/client/dist ./dist/public
COPY --from=server-builder /app/packages/server/dist ./dist/server
COPY --from=server-builder /app/packages/shared/dist ./dist/shared
COPY --from=server-builder /app/node_modules ./node_modules
COPY --from=server-builder /app/package.json ./package.json

# 复制 Python app
COPY packages/app ./dist/app

# 路径别名处理
COPY ${PWD}/register-aliases.js ./

# 环境变量
ENV NODE_ENV=production
ENV PORT=8008
ENV SQLITE_PATH=/app/data/database.sqlite

VOLUME /app/data
EXPOSE 8008

# 清理构建工具链
RUN rm -rf /root/.npm /root/.cache /tmp/* && \
    apk del --purge python3 make g++

CMD ["node", "-r", "./register-aliases.js", "dist/server/src/index.js"]
